#include <iostream>
#include<vector>
using namespace std;

int findMin(vector<int>& nums) {
    int st = 0;
    int end = nums.size() - 1;

    while(st < end) {
        int mid = st + (end - st) / 2;

        if(nums[mid] > nums[end]) {
            st = mid + 1;
        } else {
            end = mid;
        }
    }
    return nums[st];
}

int main() {
    vector<int> nums = {4,5,6,7,0,1,2};

    int result = findMin(nums);

    cout << "Minimum element: " << result << endl;

    return 0;
}
