#include <iostream>
using namespace std;

class Solution {
public:
    int mySqrt(int x) {
        long long start = 0;
        long long end = x;
        long long ans = 0;

        while (start <= end) {
            long long mid = start + (end - start) / 2;

            if (mid * mid < x) {
                ans = mid;
                start = mid + 1;
            }
            else if (mid * mid > x) {
                end = mid - 1;
            }
            else {
                return mid;
            }
        }
        return ans;
    }
};

int main() {
    Solution obj;

    int x;
    cout << "Enter number: ";
    cin >> x;

    int result = obj.mySqrt(x);

    cout << "Square root (floor): " << result << endl;

    return 0;
}
