#include <iostream>
#include <vector>
using namespace std;

class Solution
{
public:
    int searchInsert(vector<int> &nums, int target)
    {
        int start = 0;
        int end = nums.size() - 1;

        while (start <= end)
        {
            int mid = start + (end - start) / 2;

            if (nums[mid] > target)
            {
                end = mid - 1;
            }
            else if (nums[mid] < target)
            {
                start = mid + 1;
            }
            else
            {
                return mid; // this is target
            }
        }
        return start; // this is insertion position
    }
};

int main()
{
    Solution obj;

    vector<int> nums = {1, 3, 5, 6};
    int target = 2;

    int result = obj.searchInsert(nums, target);

    cout << "Index: " << result << endl;

    return 0;
}
