#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>
using namespace std;

class Solution {
public:
    bool ispossible(long long mid, int n, vector<int>& batteries) {
        long long total = 0;

        for (int i = 0; i < batteries.size(); i++) {
            total += min((long long)mid, (long long)batteries[i]);
        }

        return total >= (long long)mid * n;
    }

    long long maxRunTime(int n, vector<int>& batteries) {
        int m = batteries.size();
        long long st = 1;
        long long sum = 0;

        for (int i = 0; i < m; i++) {
            sum += batteries[i];
        }

        long long end = sum / n;
        long long ans = 0;

        while (st <= end) {
            long long mid = st + (end - st) / 2;

            if (ispossible(mid, n, batteries)) {
                ans = mid;
                st = mid + 1;
            } else {
                end = mid - 1;
            }
        }

        return ans;
    }
};

int main() {
    int n = 2;
    vector<int> batteries = {8, 12, 8};

    Solution obj;
    cout << "Maximum Run Time: " << obj.maxRunTime(n, batteries) << endl;

    return 0;
}
