#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

class Solution {
public:
    bool ispossible(vector<int>& bloomDay, int m, int k, int mid) {
        int flowers = 0;
        int bouquet = 0;

        for (int i = 0; i < bloomDay.size(); i++) {
            if (bloomDay[i] <= mid) {
                flowers++;

                if (flowers == k) {
                    bouquet++;
                    flowers = 0;
                }
            } else {
                flowers = 0;
            }
        }

        return bouquet >= m;
    }

    int minDays(vector<int>& bloomDay, int m, int k) {
        long long n = bloomDay.size();

        if (1LL * m * k > n)
            return -1;

        int st = *min_element(bloomDay.begin(), bloomDay.end());
        int end = *max_element(bloomDay.begin(), bloomDay.end());
        int ans = 0;

        while (st <= end) {
            int mid = st + (end - st) / 2;

            if (ispossible(bloomDay, m, k, mid)) {
                ans = mid;
                end = mid - 1;
            } else {
                st = mid + 1;
            }
        }

        return ans;
    }
};

int main() {
    Solution obj;

    vector<int> bloomDay = {1, 10, 3, 10, 2};
    int m = 3;
    int k = 1;

    cout << "Minimum days required: " << obj.minDays(bloomDay, m, k) << endl;

    return 0;
}
