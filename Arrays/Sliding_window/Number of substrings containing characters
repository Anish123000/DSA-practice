#include <iostream>
#include <string>
using namespace std;

class Solution {
public:
    int numberOfSubstrings(string s) {
        int a = 0, b = 0, c = 0;
        int left = 0;
        int count = 0;
        int n = s.length();

        for(int i = 0; i < n; i++){
            if(s[i] == 'a') a++;
            if(s[i] == 'b') b++;
            if(s[i] == 'c') c++;

            while(a > 0 && b > 0 && c > 0){
                count += (n - i);

                if(s[left] == 'a') a--;
                if(s[left] == 'b') b--;
                if(s[left] == 'c') c--;

                left++;
            }
        }
        return count;
    }
};

int main() {
    Solution obj;

    string s = "abcabc";
    cout << obj.numberOfSubstrings(s) << endl;

    return 0;
}
