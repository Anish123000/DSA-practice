#include <iostream>
#include <vector>
#include <climits>
using namespace std;

class Solution {
public:
    int findLengthOfShortestSubarray(vector<int>& arr) {
        int n = arr.size();
        int left = 0;
        int len = INT_MAX;
        int right = n - 1;

        while (right > 0 && arr[right - 1] <= arr[right]) {
            right--;
        }

        if (right == 0) {
            return 0;
        }

        while (left + 1 < n && arr[left] <= arr[left + 1]) {
            left++;
        }

        len = min(right, n - left - 1);

        int i = 0;
        int j = right;

        while (i <= left && j < n) {
            if (arr[i] <= arr[j]) {
                len = min(len, j - i - 1);
                i++;
            } else {
                j++;
            }
        }

        return len;
    }
};

int main() {
    vector<int> arr = {1, 2, 3, 10, 4, 2, 3, 5};

    Solution obj;
    cout << "Array: ";
    for (int x : arr) {
        cout << x << " ";
    }

    cout << "\nAnswer: " << obj.findLengthOfShortestSubarray(arr);

    return 0;
}
