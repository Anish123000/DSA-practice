#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    int atmost(vector<int>& nums, int k){
        if(k < 0) return 0;  

        int left = 0;
        int odd = 0;
        int count = 0;

        for(int i = 0; i < nums.size(); i++){
            if(nums[i] % 2 != 0){
                odd++;
            }

            while(odd > k){
                if(nums[left] % 2 != 0){
                    odd--;
                }
                left++;
            }

            count += (i - left + 1);
        }
        return count;
    }

    int numberOfSubarrays(vector<int>& nums, int k) {
        return atmost(nums, k) - atmost(nums, k - 1);
    }
};

int main() {
    Solution obj;

    vector<int> nums = {1,1,2,1,1};
    int k = 3;

    cout << obj.numberOfSubarrays(nums, k) << endl;

    return 0;
}
