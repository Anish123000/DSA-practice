#include <iostream>
#include <vector>
using namespace std;

int canCompleteCircuit(vector<int>& gas, vector<int>& cost) {
    int totalGas = 0;
    int totalCost = 0;
    int currTank = 0;
    int start = 0;

    for (int i = 0; i < gas.size(); i++) {
        totalGas += gas[i];
        totalCost += cost[i];
        currTank += gas[i] - cost[i];

    
        if (currTank < 0) {
            start = i + 1;
            currTank = 0;
        }
    }

    
    if (totalGas < totalCost) {
        return -1;
    }

    return start;
}

int main() {
    vector<int> gas  = {1, 2, 3, 4, 5};
    vector<int> cost = {3, 4, 5, 1, 2};

    int result = canCompleteCircuit(gas, cost);

    if (result == -1) {
        cout << "No possible starting station" << endl;
    } else {
        cout << "Start from index: " << result << endl;
    }

    return 0;
}
