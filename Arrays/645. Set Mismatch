#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    vector<int> findErrorNums(vector<int>& nums) {

        int n = nums.size();

        // Index 0 se n tak frequency store karenge
        vector<int> freq(n + 1, 0);

        int duplicate = -1;
        int miss = -1;

        // Frequency count
        for(int i = 0; i < n; i++) {
            freq[nums[i]]++;
        }

        // Duplicate aur missing find karo
        for(int i = 1; i <= n; i++) {

            if(freq[i] > 1) {
                duplicate = i;
            }
            else if(freq[i] < 1) {
                miss = i;
            }
        }

        return {duplicate, miss};
    }
};

int main() {
 
    vector<int> nums = {1, 2, 2, 4};

    Solution obj;

    vector<int> result = obj.findErrorNums(nums);

    cout << "Duplicate number: " << result[0] << endl;
    cout << "Missing number: " << result[1] << endl;

    return 0;
}
