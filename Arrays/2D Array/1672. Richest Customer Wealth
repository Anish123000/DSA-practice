#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int maximumWealth(vector<vector<int>>& accounts) {
    int maxx = INT_MIN;

    int n = accounts.size();
    int m = accounts[0].size();

    for(int i = 0; i < n; i++) {
        int sum = 0;

        for(int j = 0; j < m; j++) {
            sum += accounts[i][j];
        }

        maxx = max(maxx, sum);
    }

    return maxx;
}

int main() {

    vector<vector<int>> accounts = {
        {1, 2, 7},
        {3, 2, 1}
    };

    int result = maximumWealth(accounts);

    cout << "Maximum Wealth: " << result << endl;

    return 0;
}
