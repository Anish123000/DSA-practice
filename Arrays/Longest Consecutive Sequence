#include <iostream>
#include <vector>
#include <unordered_set>
#include <algorithm>

using namespace std;

class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        int ans = 0;

        unordered_set<int> s;

        // Saare elements set me daalo
        for (int i = 0; i < nums.size(); i++) {
            s.insert(nums[i]);
        }

        // Har unique element ko check karo
        for (int x : s) {

            // x sequence ka starting point hai
            if (s.find(x - 1) == s.end()) {

                int length = 1;

                // Consecutive elements check karo
                while (s.find(x + 1) != s.end()) {
                    x++;
                    length++;
                }

                // Maximum length store karo
                ans = max(ans, length);
            }
        }

        return ans;
    }
};

int main() {
    Solution s;

    vector<int> nums = {100, 4, 200, 1, 3, 2};

    int answer = s.longestConsecutive(nums);

    cout << "Longest Consecutive Sequence Length = " << answer << endl;

    return 0;
}
