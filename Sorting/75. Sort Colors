#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    void sortColors(vector<int>& nums) {
        int n = nums.size();

        int low = 0;
        int mid = 0;
        int high = n - 1;

        while (mid <= high) {

            if (nums[mid] < 1) {
                swap(nums[low], nums[mid]);
                mid++;
                low++;
            }

            else if (nums[mid] > 1) {
                swap(nums[mid], nums[high]);
                high--;
            }

            else if (nums[mid] == 1) {
                mid++;
            }
        }
    }
};

int main() {

    vector<int> nums = {2, 0, 2, 1, 1, 0};

    Solution obj;
    obj.sortColors(nums);

    cout << "Sorted array: ";

    for (int i = 0; i < nums.size(); i++) {
        cout << nums[i] << " ";
    }

    return 0;
}
