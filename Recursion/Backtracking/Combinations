#include <iostream>
#include <vector>
using namespace std;

void helper(vector<vector<int>>& ans, int start, int n, int k, vector<int>& curr)
{
    // Combination complete
    if (curr.size() == k)
    {
        ans.push_back(curr);
        return;
    }

    // Numbers choose karna
    for (int i = start; i <= n; i++)
    {
        curr.push_back(i);

        // Next number i+1 se choose hoga
        helper(ans, i + 1, n, k, curr);

        // Backtracking
        curr.pop_back();
    }
}

vector<vector<int>> combine(int n, int k)
{
    vector<vector<int>> ans;
    vector<int> curr;

    helper(ans, 1, n, k, curr);

    return ans;
}

int main()
{
    int n = 4;
    int k = 2;

    vector<vector<int>> ans = combine(n, k);

    
    for (vector<int>& combination : ans)
    {
        cout << "[";
        
        for (int i = 0; i < combination.size(); i++)
        {
            cout << combination[i];

            if (i < combination.size() - 1)
                cout << ",";
        }

        cout << "] ";
    }

    return 0;
}
