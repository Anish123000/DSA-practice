#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:

    void getallsub(vector<int>& nums, vector<vector<int>>& allsub, vector<int> ans, int start)
    {
      
        if (start == nums.size())
        {
            allsub.push_back(ans);
            return;
        }

        // Include
        ans.push_back(nums[start]);

        getallsub(nums, allsub, ans, start + 1);

        // Backtrack
        ans.pop_back();

        // Skip duplicate elements
        int next = start + 1;

        while (next < nums.size() && nums[start] == nums[next])
        {
            next++;
        }

        // Exclude
        getallsub(nums, allsub, ans, next);
    }


    vector<vector<int>> subsetsWithDup(vector<int>& nums)
    {
        sort(nums.begin(), nums.end());

        vector<vector<int>> allsub;
        vector<int> ans;

        getallsub(nums, allsub, ans, 0);

        return allsub;
    }
};


int main()
{
    Solution obj;

    vector<int> nums = {1, 2, 2};

    vector<vector<int>> result = obj.subsetsWithDup(nums);

    cout << "All subsets:" << endl;

    for (vector<int> subset : result)
    {
        cout << "[ ";

        for (int value : subset)
        {
            cout << value << " ";
        }

        cout << "]" << endl;
    }

    return 0;
}
