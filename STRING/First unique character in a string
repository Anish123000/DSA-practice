#include <iostream>
#include <unordered_map>
#include <string>
using namespace std;

int main()
{

    string s;
    cout << "Enter string: ";
    cin >> s;

    unordered_map<char, int> mp;

    for (char ch : s)
    {
        mp[ch]++;
    }

    int ans = -1;

    for (int i = 0; i < s.length(); i++)
    {
        if (mp[s[i]] == 1)
        {
            ans = i;
            break;
        }
    }

    cout << "First unique character index: " << ans << endl;

    return 0;
}
