#include <iostream>
#include <unordered_map>
using namespace std;

class Solution {
public:
    int romanToInt(string s) {
        unordered_map<char, int> mp = {
            {'I', 1}, {'V', 5}, {'X', 10},
            {'L', 50}, {'C', 100}, {'D', 500}, {'M', 1000}
        };

        int ans = 0;

        for (int i = 0; i < s.size(); i++) {
            // subtract case
            if (i < s.size() - 1 && mp[s[i]] < mp[s[i + 1]]) {
                ans -= mp[s[i]];
            } 
            // normal add case
            else {
                ans += mp[s[i]];
            }
        }

        return ans;
    }
};

int main() {
    Solution obj;

    cout << obj.romanToInt("III") << endl;      // 3
    cout << obj.romanToInt("LVIII") << endl;    // 58
    cout << obj.romanToInt("MCMXCIV") << endl;  // 1994

    return 0;
}
