#include <iostream>
#include <string>
#include <unordered_map>
using namespace std;

class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        unordered_map<char, int> need;

        for (char ch : ransomNote) {
            need[ch]++;
        }

        for (char ch : magazine) {
            if (need[ch] > 0) {
                need[ch]--;
            }
        }

        for (auto x : need) {
            if (x.second > 0) {
                return false;
            }
        }

        return true;
    }
};

int main() {
    Solution obj;

    string ransomNote = "aa";
    string magazine = "aab";

    cout << boolalpha << obj.canConstruct(ransomNote, magazine);

    return 0;
}
