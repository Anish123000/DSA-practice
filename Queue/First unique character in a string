#include <iostream>
#include <unordered_map>
#include <queue>
using namespace std;

class Solution {
public:
    int firstUniqChar(string s) {
        unordered_map<char, int> mp;
        queue<int> q;

        for (int i = 0; i < s.size(); i++) {
            if (mp.find(s[i]) == mp.end()) {
                q.push(i);
            }

            mp[s[i]]++;
        }

        while (!q.empty() && mp[s[q.front()]] > 1) {
            q.pop();
        }

        if (q.empty()) {
            return -1;
        }
        else {
            return q.front();
        }
    }
};

int main() {
    Solution obj;

    string s = "leetcode";

    cout << obj.firstUniqChar(s) << endl;

    return 0;
}
