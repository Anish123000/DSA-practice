#include <iostream>
#include <vector>
#include <deque>
using namespace std;

class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {

        deque<int> dq;
        vector<int> ans;

        for (int i = 0; i < nums.size(); i++) {

            // 1. Window se bahar wala index remove
            if (!dq.empty() && dq.front() <= i - k) {
                dq.pop_front();
            }

            // 2. Current element se chhote elements remove
            while (!dq.empty() && nums[dq.back()] <= nums[i]) {
                dq.pop_back();
            }

            // 3. Current index deque me add
            dq.push_back(i);

            // 4. Window complete hone ke baad maximum store
            if (i >= k - 1) {
                ans.push_back(nums[dq.front()]);
            }
        }

        return ans;
    }
};

int main() {

    Solution obj;

    // Input
    vector<int> nums = {1, 3, -1, -3, 5, 3, 6, 7};
    int k = 3;

 
    vector<int> result = obj.maxSlidingWindow(nums, k);

    // Result
    cout << "Input: [";
    for (int i = 0; i < nums.size(); i++) {
        cout << nums[i];
        if (i != nums.size() - 1) {
            cout << ", ";
        }
    }
    cout << "], k = " << k << endl;

    cout << "Maximum of each sliding window: [";

    for (int i = 0; i < result.size(); i++) {
        cout << result[i];
        if (i != result.size() - 1) {
            cout << ", ";
        }
    }

    cout << "]" << endl;

    return 0;
}
