#include<iostream>
#include<deque>
using namespace std;

class stack{
    deque<int>dq;
    public:

    void push(int val){
        dq.push_front(val);
    }

    void pop(){
        dq.pop_front();
    }

    int top(){
        return dq.front();
    }
};

int main(){
    stack s;
    for(int i =1;i<=5;i++){
        s.push(i);
    }

    for(int i =1;i<=5;i++){
        cout<<s.top()<<" ";
        s.pop();
    }
}
