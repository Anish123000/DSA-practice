#include<iostream>
#include<deque>
using namespace std;
class queue{
    deque<int>dq;
    public:

    void push(int val){
        dq.push_back(val);
    }

    void pop(){
        dq.pop_front();
    }

    int front(){
        return dq.front();
    }

    bool isempty(){
        return dq.empty();
    }
};
int main(){
    queue q;
    for(int i =1;i<=5;i++){
        q.push(i);
    }

    for(int i =1;i<=5;i++){
        cout<<q.front()<<" ";
        q.pop();
    }
}
