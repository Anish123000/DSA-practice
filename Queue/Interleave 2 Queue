#include<iostream>
#include<queue>
using namespace std;

void interleave(queue<int>&q){
    queue<int>first;
    int n  = q.size()/2;
    for(int i = 0;i<n;i++){
        first.push(q.front());
        q.pop();
    }

    while(!first.empty()){
        q.push(first.front());
        first.pop();

        q.push(q.front());
        q.pop();
    }
}

int main(){
    queue<int>org;
    for(int i = 1;i<=10;i++){
        org.push(i);
    }

    interleave(org);

    for(int i = 1;i<=10;i++){
        cout<<org.front()<<" ";
        org.pop();
    }
}
