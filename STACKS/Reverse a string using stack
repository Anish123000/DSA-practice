#include<iostream>
#include<string>
#include<stack>
using namespace std;

string reverse(string str){
    stack<char>s;
    string ans ;
    for(int i = 0;i<str.length();i++){
        char ch = str[i];
        s.push(ch);
    }
    while(!s.empty()){
        char ch = s.top();
        ans += ch;
        s.pop();
    }
    return ans;
}

int main(){
    string str = "abcde";
    cout<<reverse(str)<<endl;
}
