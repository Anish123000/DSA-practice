#include <iostream>
#include <vector>
#include <stack>
#include <algorithm>
using namespace std;

class Solution {
public:
    int totalSteps(vector<int>& nums) {
        stack<pair<int, int>> s;
        int ans = 0;
        int n = nums.size();

        for (int i = n - 1; i >= 0; i--) {
            int count = 0;

            while (!s.empty() && nums[s.top().first] < nums[i]) {
                int popcount = s.top().second;
                s.pop();
                count = max(count + 1, popcount);
            }

            ans = max(ans, count);
            s.push({i, count});
        }

        return ans;
    }
};

int main() {
    Solution obj;
 
    vector<int> nums = {5,3,4,4,7,3,6,11,8,5,11};

    cout << "Input Array: ";
    for (int x : nums)
        cout << x << " ";

    cout << "\n\nNumber of steps required to make the array non-decreasing: "
         << obj.totalSteps(nums) << endl;

    return 0;
}
