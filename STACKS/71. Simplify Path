#include <iostream>
#include <string>
#include <stack>
using namespace std;

class Solution {
public:
    string simplifyPath(string path) {
        string ans = "";
        stack<string> s;
        string token = "";

        for (int i = 0; i < path.length(); i++) {

            if (path[i] == '/') {

                if (token == "..") {
                    if (!s.empty()) {
                        s.pop();
                    }
                }
                else if (token == ".") {
                    token = "";
                }
                else if (token != "") {
                    s.push(token);
                }

                token = "";
            }
            else {
                token += path[i];
            }
        }

        // Last token
        if (token == "..") {
            if (!s.empty()) {
                s.pop();
            }
        }
        else if (token != "." && token != "") {
            s.push(token);
        }

        while (!s.empty()) {
            ans = "/" + s.top() + ans;
            s.pop();
        }

        if (ans == "") {
            return "/";
        }

        return ans;
    }
};

int main() {
    string path = "/a//b////c/d//././/..";

    Solution obj;

    cout << "Input: " << path << endl;
    cout << "Output: " << obj.simplifyPath(path) << endl;

    return 0;
}

