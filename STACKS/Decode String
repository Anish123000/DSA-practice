#include <iostream>
#include <stack>
#include <string>
using namespace std;

class Solution {
public:
    stack<int> ss;
    stack<string> a;

    string decodeString(string s) {
        int num = 0;
        string curr = "";

        for (char ch : s) {

            if (isdigit(ch)) {
                num = num * 10 + (ch - '0');
            }

            else if (ch == '[') {
                ss.push(num);
                a.push(curr);

                num = 0;
                curr = "";
            }

            else if (ch == ']') {
                int repeat = ss.top();
                ss.pop();

                string prev = a.top();
                a.pop();

                string temp = "";

                for (int i = 0; i < repeat; i++) {
                    temp = temp + curr;
                }

                curr = prev + temp;
            }

            else {
                curr += ch;
            }
        }

        return curr;
    }
};

int main() {

    string s = "3[a2[c]]";

    Solution obj;

    string ans = obj.decodeString(s);

    cout << "Decoded String: " << ans << endl;

    return 0;
}
