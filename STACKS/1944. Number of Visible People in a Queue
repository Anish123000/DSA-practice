#include <iostream>
#include <vector>
#include <stack>
using namespace std;

class Solution {
public:
    vector<int> canSeePersonsCount(vector<int>& heights) {

        stack<int> st;
        vector<int> ans(heights.size());

        for (int i = heights.size() - 1; i >= 0; i--) {

            int count = 0;

            while (!st.empty() && st.top() < heights[i]) {
                st.pop();
                count++;
            }

            if (!st.empty()) {
                count++;
            }

            ans[i] = count;
            st.push(heights[i]);
        }

        return ans;
    }
};

int main() {

    vector<int> heights = {10, 6, 8, 5, 11, 9};

    Solution obj;
    vector<int> ans = obj.canSeePersonsCount(heights);

    cout << "Queue Visibility\n";
    cout << "----------------\n";

    cout << "Heights : ";
    for (int x : heights)
        cout << x << " ";

    cout << "\nVisible : ";
    for (int x : ans)
        cout << x << " ";

    cout << endl;

    return 0;
}
