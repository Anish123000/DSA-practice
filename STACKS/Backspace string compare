#include <iostream>
#include <string>
#include <stack>
using namespace std;

class Solution {
public:
    bool backspaceCompare(string s, string t) {
        stack<char> st;
        stack<char> ab;

        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '#') {
                if (!st.empty()) {
                    st.pop();
                }
            }
            else {
                st.push(s[i]);
            }
        }

        for (int i = 0; i < t.size(); i++) {
            if (t[i] == '#') {
                if (!ab.empty()) {
                    ab.pop();
                }
            }
            else {
                ab.push(t[i]);
            }
        }

        while (!st.empty() && !ab.empty()) {
            if (st.top() != ab.top()) {
                return false;
            }

            st.pop();
            ab.pop();
        }

        if (st.empty() == ab.empty()) {
            return true;
        }
        else {
            return false;
        }
    }
};

int main() {
    Solution obj;

    string s = "ab#c";
    string t = "ad#c";

    cout << obj.backspaceCompare(s, t);

    return 0;
}
