#include<iostream>
#include<stack>
#include<vector>
using namespace std;

void maxAreaHisto(vector<int>height){
    int n = height.size();
    vector<int>left(n);
    vector<int>right(n);
    stack<int>s;

    // left smaller
    left[0]=  -1;
    s.push(0);
    for(int i = 1;i<n;i++){
        while(!s.empty() && height[s.top()] >= height[i]){
            s.pop();
        }
        if(s.empty()){
            left[i] = -1;
        }
        else{
            left[i] = s.top();
        }
        s.push(i);
    }

    while(!s.empty()){
        s.pop();
    }

    // right smaller
    s.push(n-1);
    right[n-1] = n;
    for(int i = n-2;i>=0; i--){
        while(!s.empty() && height[s.top()] >= height[i]){
            s.pop();
        }
        if(s.empty()){
            right[i] = n;
        }
        else{
            right[i] = s.top();
        }
        s.push(i);
    }

    int maxarea = 0;
    for(int i =0;i<n;i++){
        int ht = height[i];
        int wt = right[i] - left[i] - 1;
        int area = ht * wt;
        maxarea = max(maxarea, area);
    }
    cout<<"Maximum area is: "<<maxarea<<endl;
}

int main(){
    vector<int>height = {2,1,5,6,2,3};
    maxAreaHisto(height);
}
